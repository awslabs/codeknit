[dict]
- d0: callable/function
- d1: callable/method
- d2: calls
- d3: contains
- d4: exported
- d5: module/package
- d6: receiver=*Service
- d7: references
- d8: type/class
- d9: type/struct
- d10: value/field
[symbols]
## src/handler.py
S1 d8 L1-L6 Handler
S2 d1 L2-L3 __init__(name)
S3 d1 L5-L6 handle(request)
S4 d0 L8-L9 process(request)
## src/models.go
S5 d5 L1-L1 src
S6 d9 L3-L6 User {d4}
S7 d10 L4-L4 Name: string {d4}
S8 d10 L5-L5 Email: string {d4}
S9 d0 L8-L10 NewUser(name: string, email: string) -> *S6 {d4}
## src/service.go
S10 d9 L3-L5 Service {d4}
S11 d10 L4-L4 Name: string {d4}
S12 d0 L7-L9 NewService(name: string) -> *S10 {d4}
S13 d1 L11-L13 Run() -> string {d4, d6}

